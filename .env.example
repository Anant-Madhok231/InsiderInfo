# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# Sending account for application email (Gmail app password, not the
# account password). Generate at https://myaccount.google.com/apppasswords
MAIL_USERNAME=
MAIL_PASSWORD=

# Signs Flask session cookies. Generate a fresh random value:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Market data providers.
# https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
# https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=
# https://polygon.io/dashboard/api-keys
POLYGON_API_KEY=

# Optional transport overrides (defaults shown).
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
